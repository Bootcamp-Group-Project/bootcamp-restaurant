# EC2 deployment — copy to .env beside docker-compose.yml and fill in real values
APP_IMAGE=yourname/canteen-app   # your Docker Hub image name
# All values below are copied from your current Zeabur environment variables

# Neon PostgreSQL (same as Zeabur — no change)
SPRING_DATASOURCE_URL=jdbc:postgresql://ep-xxx.ap-southeast-1.aws.neon.tech/restaurant_db?sslmode=require
SPRING_DATASOURCE_USERNAME=your_neon_username
SPRING_DATASOURCE_PASSWORD=your_neon_password

# Stripe — key unchanged; URLs stay canteen.zeabur.app (Zeabur proxies to EC2)
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_SUCCESS_URL=https://canteen.zeabur.app/index.html?topup=success&session_id={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=https://canteen.zeabur.app/index.html?topup=cancel

# JWT — copy exact same value from Zeabur (tokens issued on old server will still work)
JWT_SECRET=your-32-char-secret

# Spring Security HTTP Basic
SECURITY_ADMIN_PASSWORD=your_admin_password
SECURITY_KITCHEN_PASSWORD=your_kitchen_password

# Cloudflare R2 image storage (if in use)
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_ENDPOINT=
R2_BUCKET=
R2_PUBLIC_URL=

# Optional
GEMINI_API_KEY=
